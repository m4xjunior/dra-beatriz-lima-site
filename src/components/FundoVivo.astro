---
// FundoVivo — a Dra. como plano de fundo VIVO de todo o site.
//
// ADR (24/07/2026): a 1ª arquitetura scrubava 145 frames WebP em canvas
// (padrão Apple). Reprovada em uso real: decode de bitmap grande por
// frame + shader simultâneo travava até em M4 Pro. Esta arquitetura usa
// <video> nativo: decode por HARDWARE, zero JS por frame, 60fps em
// qualquer aparelho. Os frames v1/ seguem no bucket se um dia voltar o
// scrub; os vídeos web vivem em v2/web_video/ (H.264 universal,
// 1440p 5.9MB · 1080p 3.8MB · mobile-pan 3.2MB/1.4MB + posters).
//
// O crop mobile 9:16 tem PAN que segue a Dra. (keyframes do QA visual).
// A escolha do arquivo é por JS (matchMedia + effectiveType) — o
// atributo media em <source> de <video> não é confiável cross-browser.
//
// Guardas: prefers-reduced-motion e Save-Data ficam SÓ com o poster
// (imagem estática) — nenhum byte de vídeo baixado.
const RAIZ = "https://storage.googleapis.com/dra-beatriz-lima-estetica/v2/web_video";
---

<div class="fundo-vivo" aria-hidden="true" data-fundo-vivo data-raiz={RAIZ}>
  <video
    class="fundo-vivo__video"
    data-fundo-video
    muted
    loop
    playsinline
    autoplay
    preload="metadata"
    poster={`${RAIZ}/poster-desktop.jpg`}></video>
  <div class="fundo-vivo__veu"></div>
</div>

<script>
  // MODO HÍBRIDO (spec do Max, 24/07/2026): parado, o vídeo toca
  // sozinho; ao deslizar, o scroll comanda os frames NOS DOIS SENTIDOS,
  // relativo ao frame atual — a cada gesto rebaseamos um offset
  // (offset = tempoAtual − mapa(scroll)), então retomar o scroll nunca
  // pula. 200ms sem scroll = volta a tocar de onde parou. Os arquivos
  // *-scrub.mp4 têm GOP de 4 frames sem B-frames: seek bidirecional
  // instantâneo com decode por hardware — é isso que permite scrubar
  // <video> sem o jank que matou a arquitetura de frames em canvas.
  const caixa = document.querySelector<HTMLElement>("[data-fundo-vivo]");
  const video = document.querySelector<HTMLVideoElement>("[data-fundo-video]");
  if (caixa && video) {
    const raiz = caixa.dataset.raiz ?? "";
    const mobile = window.matchMedia("(max-width: 899px)").matches;
    const reduzido = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const nav = navigator as {
      connection?: { effectiveType?: string; saveData?: boolean };
    };
    const lenta =
      nav.connection?.saveData === true ||
      nav.connection?.effectiveType === "slow-2g" ||
      nav.connection?.effectiveType === "2g" ||
      nav.connection?.effectiveType === "3g";

    video.poster = `${raiz}/${mobile ? "poster-mobile.jpg" : "poster-desktop.jpg"}`;

    if (!reduzido && !(mobile && lenta)) {
      const arquivo = mobile
        ? (lenta ? "hero-mobile-720-scrub" : "hero-mobile-1080-scrub")
        : (window.innerWidth * (window.devicePixelRatio || 1) > 2200
            ? "hero-1440-scrub"
            : "hero-1080-scrub");
      video.src = `${raiz.replace("/web_video", "/scrub_video")}/${arquivo}.mp4`;
      video.preload = "auto";
      video.loop = true;

      let modo: "tocando" | "scrubando" = "tocando";
      let alvo = 0;
      let offset = 0;
      let idleTimer: ReturnType<typeof setTimeout> | undefined;

      const progresso = () => {
        const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        return window.scrollY / max;
      };
      const mod = (t: number, d: number) => ((t % d) + d) % d;

      video.addEventListener("loadedmetadata", () => {
        video.play().catch(() => {
          /* autoplay bloqueado: primeiro gesto de scroll assume */
        });
      });

      window.addEventListener(
        "scroll",
        () => {
          if (!video.duration) return;
          if (modo === "tocando") {
            // Rebase: o comando passa a ser RELATIVO ao frame atual.
            modo = "scrubando";
            video.pause();
            offset = video.currentTime - progresso() * video.duration;
          }
          alvo = progresso() * video.duration + offset;
          clearTimeout(idleTimer);
          idleTimer = setTimeout(() => {
            modo = "tocando";
            video.play().catch(() => {});
          }, 200);
        },
        { passive: true },
      );

      // Lerp do currentTime só enquanto scrubando — caminho mais curto
      // considerando o wrap do loop (fim↔início são vizinhos).
      const tick = () => {
        if (modo === "scrubando" && video.duration) {
          const atual = video.currentTime;
          const alvoMod = mod(alvo, video.duration);
          let delta = alvoMod - atual;
          if (Math.abs(delta) > video.duration / 2) {
            delta -= Math.sign(delta) * video.duration;
          }
          if (Math.abs(delta) > 0.02) {
            video.currentTime = mod(atual + delta * 0.16, video.duration);
          }
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }
</script>

<style>
  .fundo-vivo {
    position: fixed;
    inset: 0;
    z-index: 0;
  }

  .fundo-vivo__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Véu de contraste: o conteúdo em ilhas de vidro precisa de base
     estável de leitura sobre um fundo que se move — gradiente sutil do
     tema, mais denso nas bordas onde vive o texto. */
  .fundo-vivo__veu {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(26, 22, 17, 0.30) 0%,
        rgba(26, 22, 17, 0.06) 30%,
        rgba(26, 22, 17, 0.10) 70%,
        rgba(26, 22, 17, 0.42) 100%
      );
  }
</style>
