---
// AssinaturaPressao — assinatura tipográfica que fecha a landing:
// "BEATRIZ LIMA" gigante em Bricolage variável, com as letras reagindo
// à pressão do cursor/dedo (TextPressure, ReactBits — ver
// reactbits/TextPressure.jsx). client:visible: o JS da ilha React só
// baixa quando a seção entra no viewport — custo zero no LCP do hero.
import TextPressure from "../reactbits/TextPressure.jsx";
---

<section class="assinatura" aria-label="Assinatura Beatriz Lima">
  <div class="assinatura__area">
    <TextPressure client:visible text="BEATRIZ LIMA" />
  </div>
</section>

<style>
  .assinatura {
    background: var(--surface-base);
    overflow: hidden;
    padding-block: var(--space-section);
  }

  .assinatura__area {
    max-width: var(--container-xl);
    margin-inline: auto;
    padding-inline: var(--space-container-pad);
    height: clamp(7rem, 22vw, 19rem);
  }
</style>
