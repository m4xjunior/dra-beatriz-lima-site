    <script>
      // Comportamento da página definitiva (porte 1:1 do DC script):
      // menu mobile, fundo vivo v4 e pressão tipográfica — vanilla, sem
      // React. PT-BR, tokens e guardas preservados.

      // ---- menu mobile ----
      const alternador = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
      const menuMobile = document.querySelector<HTMLElement>("[data-nav-mobile]");
      if (alternador && menuMobile) {
        const fechar = () => {
          alternador.setAttribute("aria-expanded", "false");
          menuMobile.dataset.open = "false";
        };
        alternador.addEventListener("click", () => {
          const aberto = alternador.getAttribute("aria-expanded") === "true";
          alternador.setAttribute("aria-expanded", String(!aberto));
          menuMobile.dataset.open = String(!aberto);
        });
        menuMobile.querySelectorAll("a").forEach((a) => a.addEventListener("click", fechar));
      }

      // ---- fundo vivo v4 (definitivo): mapa absoluto + cap de velocidade ----
      const caixa = document.querySelector<HTMLElement>("[data-fundo-vivo]");
      const video = document.querySelector<HTMLVideoElement>("[data-fundo-video]");
      const poster = document.querySelector<HTMLElement>("[data-fundo-poster]");
      if (caixa && video) {
        const raiz = caixa.dataset.raiz ?? "";
        const mobile = window.matchMedia("(max-width: 920px)").matches;
        const reduzido = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const nav = navigator as { connection?: { effectiveType?: string; saveData?: boolean } };
        const lenta =
          nav.connection?.saveData === true ||
          ["slow-2g", "2g", "3g"].includes(nav.connection?.effectiveType ?? "");

        const posterUrl = `${raiz}/${mobile ? "poster-mobile.jpg" : "poster-desktop.jpg"}`;
        if (poster) poster.style.backgroundImage = `url("${posterUrl}")`;
        video.poster = posterUrl;

        if (!reduzido && !(mobile && lenta)) {
          const arquivo = mobile
            ? (lenta ? "hero-mobile-720-scrub" : "hero-mobile-1080-scrub")
            : (window.innerWidth * (window.devicePixelRatio || 1) > 2200
                ? "hero-1440-scrub"
                : "hero-1080-scrub");
          video.src = `${raiz.replace("/web_video", "/scrub_video")}/${arquivo}.mp4`;
          video.preload = "auto";
          video.loop = true;

          let modo: "tocando" | "scrubando" = "tocando";
          let alvo = 0;
          let idleTimer: ReturnType<typeof setTimeout> | undefined;
          const limitar = (t: number, d: number) => Math.min(d - 0.04, Math.max(0, t));
          const progresso = () => {
            const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
            return Math.min(1, Math.max(0, window.scrollY / max));
          };

          video.addEventListener("loadedmetadata", () => {
            video.play().catch(() => {});
          });

          window.addEventListener(
            "scroll",
            () => {
              if (!video.duration) return;
              if (modo === "tocando") {
                modo = "scrubando";
                video.pause();
              }
              alvo = limitar(progresso() * video.duration, video.duration);
              clearTimeout(idleTimer);
              // Segura o frame ~900ms antes de ela voltar a viver sozinha.
              idleTimer = setTimeout(() => {
                modo = "tocando";
                video.play().catch(() => {});
              }, 900);
            },
            { passive: true },
          );

          const toque = window.matchMedia("(pointer: coarse)").matches;
          const intervaloMinimo = toque ? 90 : 0;
          const capPasso = toque ? 0.05 : 0.09;
          let ultimoSeek = 0;
          const tick = () => {
            if (modo === "scrubando" && video.duration && !video.seeking) {
              const agora = performance.now();
              const delta = alvo - video.currentTime;
              if (Math.abs(delta) > 0.01 && agora - ultimoSeek >= intervaloMinimo) {
                ultimoSeek = agora;
                const passo = Math.max(-capPasso, Math.min(capPasso, delta * 0.32));
                video.currentTime = limitar(video.currentTime + passo, video.duration);
              }
            }
            requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      }

      // ---- pressão tipográfica (assinatura), vanilla ----
      const area = document.querySelector<HTMLElement>("[data-pressure-area]");
      const titulo = document.querySelector<HTMLElement>("[data-pressure-titulo]");
      if (area && titulo) {
        const spans = Array.from(titulo.querySelectorAll("span"));
        const minFont = window.matchMedia("(max-width: 920px)").matches ? 34 : 52;
        const n = spans.length;
        const dimensionar = () => {
          const cw = area.getBoundingClientRect().width;
          if (!cw) return;
          let tamanho = Math.max(cw / (n / 2), minFont);
          titulo.style.fontSize = `${tamanho}px`;
          requestAnimationFrame(() => {
            const real = titulo.scrollWidth;
            if (real > cw) {
              tamanho = Math.max(minFont, tamanho * (cw / real) * 0.98);
              titulo.style.fontSize = `${tamanho}px`;
            }
          });
        };
        dimensionar();
        let deb: ReturnType<typeof setTimeout> | undefined;
        window.addEventListener("resize", () => {
          clearTimeout(deb);
          deb = setTimeout(dimensionar, 120);
        });

        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          const mouse = { x: 0, y: 0 };
          const cursor = { x: 0, y: 0 };
          const r0 = area.getBoundingClientRect();
          mouse.x = cursor.x = r0.left + r0.width / 2;
          mouse.y = cursor.y = r0.top + r0.height / 2;
          window.addEventListener("mousemove", (e) => {
            cursor.x = e.clientX;
            cursor.y = e.clientY;
          });
          window.addEventListener(
            "touchmove",
            (e) => {
              const t = e.touches[0];
              if (t) {
                cursor.x = t.clientX;
                cursor.y = t.clientY;
              }
            },
            { passive: true },
          );

          const atributo = (d: number, maxD: number, min: number, max: number) =>
            Math.max(min, max - Math.abs((max * d) / maxD) + min);
          let visivel = true;
          new IntersectionObserver((es) => {
            visivel = es[0].isIntersecting;
          }).observe(area);

          const animar = () => {
            if (visivel) {
              mouse.x += (cursor.x - mouse.x) / 15;
              mouse.y += (cursor.y - mouse.y) / 15;
              const rt = titulo.getBoundingClientRect();
              const maxD = rt.width / 2 || 1;
              for (const span of spans) {
                const r = span.getBoundingClientRect();
                const d = Math.hypot(r.x + r.width / 2 - mouse.x, r.y + r.height / 2 - mouse.y);
                const wght = Math.floor(atributo(d, maxD, 200, 800));
                const wdth = Math.floor(atributo(d, maxD, 75, 100));
                const s = `'wght' ${wght}, 'wdth' ${wdth}`;
                if (span.style.fontVariationSettings !== s) span.style.fontVariationSettings = s;
              }
            }
            requestAnimationFrame(animar);
          };
          requestAnimationFrame(animar);
        }
      }
    </script>
  </body>
</html>
