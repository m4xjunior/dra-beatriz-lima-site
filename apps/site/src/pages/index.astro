---
// Landing — a página definitiva (direção IMMERSIVE do Claude Design,
// aprovada em 25/07/2026).
//
// ADR ANTERIOR, REVOGADA (25/07/2026): esta rota foi escrita como um
// arquivo único de 568 linhas — nav, driver do vídeo, cinco dobras, CSS
// global e três scripts inline — para bater 1:1 com o artefato de
// design. O custo apareceu rápido: nav e driver de vídeo passaram a
// existir em DUAS cópias que divergiram (breakpoint 920 vs 899, clamp
// 0.04 vs 0.05), a assinatura tipográfica ganhou uma segunda
// implementação em vanilla, e os três cartões de procedimento foram
// hardcodados com resumos reescritos, divergindo do .md que é a fonte
// de verdade clínica.
//
// A composição por seções abaixo entrega o MESMO resultado visual sem
// nenhuma dessas duplicações. Fidelidade ao design não exigia arquivo
// único; exigia o mesmo CSS — que veio junto, dobra por dobra.
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/secoes/Hero.astro";
import Posicionamento from "../components/secoes/Posicionamento.astro";
import Pilares from "../components/secoes/Pilares.astro";
import GaleriaProcedimentos from "../components/secoes/GaleriaProcedimentos.astro";
import Resultados from "../components/secoes/Resultados.astro";
import AssinaturaPressao from "../components/secoes/AssinaturaPressao.astro";

const titulo = "Dra. Beatriz Lima — Biomédica Esteta";
const descricao =
  "Consultório de biomedicina estética em Goiânia. Critério clínico e avaliação individual — estética que valoriza você.";
---

<BaseLayout title={titulo} description={descricao} theme="immersive">
  <Hero />
  <Posicionamento />
  <Pilares />
  <GaleriaProcedimentos />
  {/* Recorte de 3 na home — a prova visual vem logo depois do catálogo,
      enquanto a paciente ainda está decidindo, e o resto mora em
      /resultados para a home não virar um rolo de fotos. */}
  <Resultados limite={3} />
  <AssinaturaPressao />
</BaseLayout>
