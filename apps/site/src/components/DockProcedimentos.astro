---
// DockProcedimentos — atalho persistente para os cinco procedimentos,
// com o Dock do ReactBits (ver reactbits/Dock.jsx).
//
// POR QUE ISTO EXISTE: até aqui o site não tinha nenhuma navegação de
// procedimento no celular além do hambúrguer — para pular de um
// procedimento a outro era preciso voltar ao catálogo. No toque este
// componente é a barra de navegação de verdade, ancorada no rodapé; no
// desktop ele flutua e ganha a magnificação estilo macOS.
//
// Dados do BUILD (collection 'procedimentos'), item ativo derivado da
// rota — a ilha React não busca nada em runtime.
//
// Como o `imagemCapa` ainda não existe em nenhum .md, cada item entra
// com a inicial do procedimento. Quando as fotos chegarem, a miniatura
// aparece sozinha.
import { getCollection } from "astro:content";
import Dock from "./reactbits/Dock.jsx";

const { pathname } = Astro.url;

// Rótulo de dock é caixa de 8 caracteres, não de 40. Nem o título nem o
// eyebrow servem cortados ("PREENCHIMENTO LABIAL" vira "PREEN…", que não
// diz nada), e a inicial do título também não discrimina — três dos
// cinco procedimentos começam com P. A `categoria` do schema já é o
// agrupamento clínico certo, então é dela que sai o par rótulo/sigla.
// Categoria nova sem entrada aqui quebra o build, o que é o desejado:
// é decisão de copy, não de código, e precisa passar por alguém.
const ROTULOS: Record<string, { curto: string; sigla: string }> = {
  labios: { curto: "Lábios", sigla: "LÁ" },
  bioestimulador: { curto: "Colágeno", sigla: "CO" },
  "toxina-harmonizacao": { curto: "Toxina", sigla: "TO" },
  peeling: { curto: "Peelings", sigla: "PE" },
  "protocolo-pele": { curto: "Protocolos", sigla: "PR" },
};

const procedimentos = (
  await getCollection("procedimentos", ({ data }) => data.publicado)
).sort((a, b) => a.data.ordem - b.data.ordem);

const itens = procedimentos.map((item) => {
  const rotulo = ROTULOS[item.data.categoria];
  if (!rotulo) {
    throw new Error(
      `DockProcedimentos: falta rótulo curto para a categoria "${item.data.categoria}" (procedimento "${item.id}"). Adicione em ROTULOS.`,
    );
  }
  return {
    href: `/procedimentos/${item.id}`,
    rotulo: rotulo.curto,
    inicial: rotulo.sigla,
    // Nome completo pro leitor de tela: o rótulo curto é abreviação
    // visual, e "Lábios" sozinho não descreve o destino do link.
    descricao: item.data.titulo,
    imagem: item.data.imagemCapa,
    ativo: pathname === `/procedimentos/${item.id}`,
  };
});
---

<div class="dock-ancora" data-dock-ancora>
  <Dock client:visible itens={itens} />
</div>

<script>
  // O Dock vive no pé da tela; os CTAs do hero também. Encolher o hero
  // não resolve — uma barra centralizada e fixa sempre vai cruzar o que
  // estiver ancorado embaixo. Então ela só entra depois que o hero sai:
  // a primeira tela fica limpa, e o atalho aparece exatamente quando
  // passa a ser útil.
  //
  // IntersectionObserver, não listener de scroll: dispara duas vezes na
  // vida da página em vez de a cada quadro do gesto — que é o custo que
  // este trabalho está justamente tirando do celular.
  const ancora = document.querySelector<HTMLElement>("[data-dock-ancora]");
  const hero = document.querySelector<HTMLElement>("#topo");

  if (ancora && hero) {
    ancora.dataset.oculto = "true";
    new IntersectionObserver(
      ([entrada]) => {
        ancora.dataset.oculto = String(entrada.isIntersecting);
      },
      // Some assim que o hero ocupa mais de um terço da tela.
      { threshold: 0.34 },
    ).observe(hero);
  }
  // Sem hero (todas as rotas menos a home) o Dock nasce visível.
</script>

<style>
  /* No desktop o dock flutua sobre o rodapé; no toque ele ancora no pé
     da tela e vira navegação de verdade. Em ambos vive acima do
     conteúdo mas abaixo de qualquer overlay. */
  .dock-ancora {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-sticky);
    display: flex;
    justify-content: center;
    pointer-events: none;
    /* iPhone com barra de gestos: sem isto o dock fica sob a barra. */
    padding-bottom: env(safe-area-inset-bottom, 0px);
    transition:
      transform var(--duration-slow) var(--ease-entrance),
      opacity var(--duration-base) var(--ease-standard);
  }

  .dock-ancora[data-oculto="true"] {
    transform: translateY(115%);
    opacity: 0;
  }

  /* Escondido de verdade: um link invisível ainda seria tabulável. */
  .dock-ancora[data-oculto="true"] :global(.dock) {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .dock-ancora {
      transition: none;
    }
  }

  .dock-ancora :global(.dock) {
    pointer-events: auto;
    max-width: 100%;
  }

  .dock-ancora :global(.dock__lista) {
    display: flex;
    align-items: flex-end;
    gap: var(--space-inline-xs);
    margin: 0;
    padding: var(--space-inline-xs);
    list-style: none;
    /* Véu denso, NÃO blur: backdrop-filter é desligado globalmente em
       toque (base.css, decisão de perf medida em Android). O dock foi
       desenhado já contando com isso em vez de brigar. */
    /* Duas camadas: obsidiana OPACA por baixo do véu. O véu sozinho é
       0.68 de alfa, e a barra fica sobre o vídeo — texto do conteúdo
       atravessava o dock (visto em captura). Sem blur de propósito:
       backdrop-filter é desligado globalmente em toque (base.css,
       decisão de perf medida em Android). */
    background-color: var(--color-obsidian-950);
    background-image: linear-gradient(var(--veil-dark-3), var(--veil-dark-3));
    border: var(--border-width-hairline) solid var(--surface-glass-border);
    box-shadow: var(--elevation-floating);
    border-radius: var(--radius-xl);
    margin-bottom: var(--space-inline-md);
  }

  .dock-ancora :global(.dock__item) {
    display: flex;
  }

  .dock-ancora :global(.dock__link) {
    --dock-escala: 0;

    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: var(--space-inline-xs) 6px;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-muted);
    transition:
      color var(--duration-base) var(--ease-standard),
      background-color var(--duration-base) var(--ease-standard);
  }

  .dock-ancora :global(.dock__link:hover),
  .dock-ancora :global(.dock__link[data-ativo="true"]) {
    color: var(--text-accent);
  }

  .dock-ancora :global(.dock__link:focus-visible) {
    outline: none;
    box-shadow: var(--ring-focus);
  }

  /* A magnificação: o JS só escreve --dock-escala (0..0,55) e o
     transform é composto na GPU. Nenhum layout por frame. */
  .dock-ancora :global(.dock__moldura) {
    display: grid;
    place-items: center;
    width: var(--dock-tamanho, 40px);
    height: var(--dock-tamanho, 40px);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: var(--border-width-hairline) solid var(--surface-glass-border);
    background: linear-gradient(
      160deg,
      var(--color-obsidian-600) 0%,
      var(--color-obsidian-900) 100%
    );
    transform: scale(calc(1 + var(--dock-escala)))
      translateY(calc(var(--dock-escala) * -8px));
    transform-origin: 50% 100%;
    will-change: transform;
  }

  .dock-ancora :global(.dock__link[data-ativo="true"] .dock__moldura) {
    border-color: var(--color-gold-500);
    box-shadow: var(--bloom-gold-soft);
  }

  .dock-ancora :global(.dock__imagem) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .dock-ancora :global(.dock__rotulo) {
    font-family: var(--type-eyebrow-font);
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    text-align: center;
    line-height: 1.15;
    white-space: nowrap;
  }

  .dock-ancora :global(.dock__inicial) {
    font-family: var(--type-display-font);
    font-variation-settings: "opsz" 18, "wght" 500, "wdth" 88;
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-gold-300);
  }

  /* ---------- TOQUE: barra de navegação, não enfeite ---------- */
  @media (pointer: coarse) {
    .dock-ancora :global(.dock) {
      width: 100%;
    }

    .dock-ancora :global(.dock__lista) {
      justify-content: space-around;
      gap: 0;
      /* Colado no pé da tela: as bordas laterais e de baixo sairiam
         como um traço solto na moldura do aparelho. */
      border-inline: none;
      border-bottom: none;
      border-radius: 0;
      margin-bottom: 0;
      padding-inline: 4px;
      width: 100%;
    }

    .dock-ancora :global(.dock__item) {
      flex: 1 1 0;
    }

    /* 44px é o mínimo de área de toque; a moldura sozinha tem 40. */
    .dock-ancora :global(.dock__link) {
      width: 100%;
      min-height: 44px;
      justify-content: center;
    }

    .dock-ancora :global(.dock__moldura) {
      --dock-tamanho: 34px;
      transform: none;
      will-change: auto;
    }

    .dock-ancora :global(.dock__link:active .dock__moldura) {
      transform: scale(0.94);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dock-ancora :global(.dock__moldura) {
      transform: none;
      transition: none;
    }
  }
</style>
