---
// FundoVivo — a Dra. como plano de fundo VIVO de todo o site.
//
// A marcação e o tratamento (poster + scrim direcional + grain) são os
// da versão DEFINITIVA que antes vivia inline em pages/index.astro; o
// componente passou a ser a única cópia quando a home migrou para o
// BaseLayout (25/07/2026). O comportamento mora em lib/fundo-vivo.ts —
// ver lá o porquê da fila de um seek.
//
// O crop mobile 9:16 segue a Dra. por object-position. O `transform:
// scale(1.12)` que esta cópia tinha saiu: reamostrar um <video> fixed
// de viewport inteira a cada frame apresentado é custo de compositor
// puro, e a versão definitiva da home nunca precisou dele para chegar
// no mesmo enquadramento.
//
// A escolha do arquivo é por JS (matchMedia + effectiveType) — o
// atributo media em <source> de <video> não é confiável cross-browser.
//
// Guardas: prefers-reduced-motion e Save-Data ficam SÓ com o poster —
// nenhum byte de vídeo baixado.
const RAIZ = "https://storage.googleapis.com/dra-beatriz-lima-estetica/v2/web_video";
---

<div class="fundo-vivo" aria-hidden="true" data-fundo-vivo data-raiz={RAIZ}>
  <div class="fundo-vivo__poster" data-fundo-poster></div>
  <video
    class="fundo-vivo__video"
    data-fundo-video
    muted
    loop
    playsinline
    preload="metadata"></video>
  <div class="fundo-vivo__scrim"></div>
  <div class="fundo-vivo__grain"></div>
</div>

<script>
  import { iniciarFundoVivo } from "../lib/fundo-vivo";

  const caixa = document.querySelector<HTMLElement>("[data-fundo-vivo]");
  const video = document.querySelector<HTMLVideoElement>("[data-fundo-video]");
  const poster = document.querySelector<HTMLElement>("[data-fundo-poster]");

  if (caixa && video) iniciarFundoVivo({ caixa, video, poster });
</script>

<style>
  /* contain: o fundo é uma camada isolada de viewport inteira — nada
     dentro dele influencia o layout de fora, e dizer isso ao browser
     tira essa subárvore do escopo de recálculo durante o scroll. */
  .fundo-vivo {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    contain: strict;
    background: var(--color-obsidian-900, #0a0805);
  }

  /* Enquadramento definitivo: ela à direita do centro no desktop (a
     coluna de leitura vive à esquerda, sobre o scrim). */
  .fundo-vivo__poster,
  .fundo-vivo__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 18%;
  }

  .fundo-vivo__poster {
    background: 62% 18% / cover no-repeat var(--color-obsidian-900, #0a0805);
  }

  /* SCRIM DIRECIONAL: escurece a coluna de texto à ESQUERDA e some
     antes do centro-direita — onde a Dra. fica NÍTIDA. Faixas topo/pé
     dão contraste a nav e rodapé. Substitui os véus de bloco (os ovais
     reprovados nunca voltam). */
  .fundo-vivo__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        97deg,
        rgba(10, 8, 5, 0.88) 0%,
        rgba(10, 8, 5, 0.72) 26%,
        rgba(10, 8, 5, 0.32) 50%,
        rgba(10, 8, 5, 0.04) 68%,
        transparent 80%
      ),
      linear-gradient(
        180deg,
        rgba(10, 8, 5, 0.5) 0%,
        transparent 20%,
        transparent 66%,
        rgba(10, 8, 5, 0.5) 100%
      );
  }

  .fundo-vivo__grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: var(--grain);
    background-size: 190px 190px;
    opacity: 0.06;
    mix-blend-mode: overlay;
  }

  /* Mobile: ela central e o scrim vira escurecimento vertical — o texto
     ancora no pé (ver a faixa de leitura do hero). */
  @media (max-width: 920px) {
    .fundo-vivo__poster,
    .fundo-vivo__video {
      object-position: 52% 16%;
    }

    .fundo-vivo__scrim {
      background: linear-gradient(
        180deg,
        rgba(10, 8, 5, 0.42) 0%,
        rgba(10, 8, 5, 0.3) 42%,
        rgba(10, 8, 5, 0.66) 100%
      );
    }

    /* mix-blend-mode força uma camada de composição extra sobre o vídeo
       — barato no desktop, mensurável no Android durante o scrub. */
    .fundo-vivo__grain {
      display: none;
    }
  }
</style>
