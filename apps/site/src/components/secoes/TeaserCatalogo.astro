---
// TeaserCatalogo — dobra 04, amostra do catálogo na landing.
//
// Lê a collection 'procedimentos'; nunca hardcoda dado clínico. Até
// 25/07 a home trazia estes três cartões escritos à mão no HTML, com os
// resumos REESCRITOS — duas fontes de verdade para o mesmo conteúdo
// clínico, que já tinham divergido do .md. O cartão é o ServiceCard,
// mesmo componente do catálogo completo.
import { getCollection } from "astro:content";
import ServiceCard from "../ServiceCard.astro";
import Button from "../Button.astro";

const destaques = (
  await getCollection("procedimentos", ({ data }) => data.publicado)
)
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .slice(0, 3);
---

<section class="secao teaser" id="procedimentos">
  <div class="secao__inner">
    <div class="lead" data-bl-reveal>
      <p class="secao__idx">04 — Procedimentos</p>
      <h2 class="teaser__titulo display on-video">
        Um catálogo por indicação, não por tendência
      </h2>
      <p class="teaser__corpo on-video">
        Preenchimento labial, bioestimuladores de colágeno, toxina botulínica e
        harmonização, peelings e protocolos de pele — cada um com indicações e
        contraindicações claras, para você decidir com informação, não com
        pressa.
      </p>
    </div>

    <div class="teaser__grade">
      {
        destaques.map((item) => (
          <ServiceCard
            slug={item.id}
            eyebrow={item.data.eyebrow}
            title={item.data.titulo}
            summary={item.data.resumo}
            featured={item.data.carroChefe}
          />
        ))
      }
    </div>

    <div class="teaser__mais lead" data-bl-reveal>
      <Button href="/procedimentos" variante="texto">
        Ver todos os procedimentos →
      </Button>
    </div>
  </div>
</section>

<style>
  .teaser__titulo {
    font-variation-settings: "opsz" 44, "wght" 600, "wdth" 96;
    font-size: clamp(1.9rem, 4.4vw, var(--font-size-3xl));
    line-height: 1.02;
    letter-spacing: var(--type-display-tracking);
    margin: var(--space-stack-xs) 0 var(--space-stack-sm);
    max-width: 20ch;
    text-wrap: balance;
    color: var(--text-heading);
  }

  .teaser__corpo {
    font-size: var(--font-size-md);
    line-height: var(--type-body-leading);
    color: var(--text-muted);
    max-width: 56ch;
    margin: 0 0 var(--space-stack-lg);
  }

  /* minmax(min(100%, 15rem), 1fr): o min() interno é o que impede o
     track de ficar mais largo que a coluna no 360px — bug real de
     overflow lateral, não estética. */
  .teaser__grade {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-gutter);
    perspective: 1300px;
  }

  .teaser__mais {
    margin-top: var(--space-stack-lg);
  }
</style>
