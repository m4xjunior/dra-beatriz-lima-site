---
// Posicionamento — o discurso central da marca, em texto editorial.
import Divider from "../Divider.astro";
---

<section class="posicionamento">
  <div class="posicionamento__inner">
    <!-- ilha de vidro: o texto flutua sobre o FundoVivo, garantindo leitura
         AA mesmo com o vídeo dela em movimento por trás (padrão .hero__ilha) -->
    <div class="posicionamento__ilha" data-bl-reveal>
      <!-- hairline dourada CONTIDA na ilha — nunca cruza o rosto no vídeo -->
      <Divider fade />
      <p class="posicionamento__eyebrow">POSICIONAMENTO</p>

      <div class="posicionamento__citacao-bloco">
        <span class="posicionamento__chave" aria-hidden="true">{"{"}</span>
        <div>
          <blockquote class="posicionamento__citacao">
            "Valor não é só preço. A estética deve valorizar quem você é —
            nunca transformar você em outra pessoa."
          </blockquote>
          <cite class="posicionamento__atribuicao">
            Dra. Beatriz Lima · Biomédica Esteta
          </cite>
        </div>
      </div>

      <p class="posicionamento__corpo">
        Critério clínico acima de tendência. Cada avaliação parte da sua
        individualidade, não de um padrão de rosto ou de uma referência de
        rede social. Resultado natural, elegante e proporcional — sem
        exageros.
      </p>
    </div>
  </div>
</section>

<style>
  .posicionamento {
    padding-block: var(--space-section);
  }

  .posicionamento__inner {
    max-width: var(--container-prose);
    margin-inline: auto;
    padding-inline: var(--space-container-pad);
    text-align: center;
  }

  /* ilha de vidro do DS — mesma superfície do .hero__ilha */
  .posicionamento__ilha {
    padding: var(--space-stack-lg);
    background: var(--surface-glass-strong);
    -webkit-backdrop-filter: blur(18px) saturate(var(--glass-saturate, 1.4));
    backdrop-filter: blur(18px) saturate(var(--glass-saturate, 1.4));
    border: 1px solid var(--surface-glass-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--bloom);
  }

  .posicionamento__eyebrow {
    font-family: var(--type-eyebrow-font);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--type-eyebrow-tracking);
    color: var(--text-accent);
    margin: var(--space-stack-lg) 0 var(--space-stack-sm);
  }

  .posicionamento__citacao-bloco {
    display: flex;
    gap: var(--space-inline-md);
    align-items: flex-start;
    text-align: left;
    margin: 0 0 var(--space-stack-md);
  }

  .posicionamento__chave {
    flex-shrink: 0;
    font-family: var(--type-display-font);
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 0.8;
    background: var(--gradient-gold-text);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .posicionamento__citacao {
    font-family: var(--type-quote-font);
    font-style: italic;
    font-size: var(--font-size-2xl);
    line-height: var(--line-height-snug);
    color: var(--text-heading);
    margin: 0 0 var(--space-stack-sm);
  }

  .posicionamento__atribuicao {
    display: block;
    font-family: var(--type-eyebrow-font);
    font-style: normal;
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--type-eyebrow-tracking);
    color: var(--text-accent);
    margin: 0;
  }

  .posicionamento__corpo {
    font-size: var(--font-size-md);
    line-height: var(--type-body-leading);
    color: var(--text-muted);
    margin: 0;
  }

  /* mobile 360–430: ilha respira menos, sem deformar */
  @media (max-width: 899px) {
    .posicionamento__ilha {
      padding: var(--space-stack-md);
    }
  }
</style>
