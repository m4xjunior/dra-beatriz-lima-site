---
// GaleriaProcedimentos — a vitrine dos procedimentos, com o ChromaGrid
// do ReactBits (ver reactbits/ChromaGrid.jsx).
//
// Os dados vêm do BUILD, da collection 'procedimentos' — a ilha React
// recebe tudo pronto por prop e não busca nada em runtime.
//
// FOTOGRAFIA: o campo `imagemCapa` existe no schema desde o começo e
// nunca teve consumidor. Agora tem. Enquanto um procedimento não
// declarar o campo, a peça renderiza a composição tipográfica de
// descanso — quando as fotos chegarem, basta preencher o .md e apontar
// o arquivo em /imagens/procedimentos/. Nenhum código muda.
//
// Regulatório (CFBM Res. 330/2020): as imagens aqui são ilustrativas /
// macro clínico. NUNCA antes/depois de paciente — nem com consentimento
// nesta etapa, é decisão de escopo registrada em content.config.ts.
//
// Esta dobra SUBSTITUI o antigo TeaserCatalogo (3 cartões). Manter os
// dois seria mostrar os mesmos procedimentos duas vezes na mesma
// página — a vitrine já traz os cinco, com imagem, e o botão leva ao
// catálogo, que é onde moram indicações e contraindicações.
import { getCollection } from "astro:content";
import ChromaGrid from "../reactbits/ChromaGrid.jsx";
import Button from "../Button.astro";

const procedimentos = (
  await getCollection("procedimentos", ({ data }) => data.publicado)
).sort((a, b) => a.data.ordem - b.data.ordem);

const itens = procedimentos.map((item) => ({
  href: `/procedimentos/${item.id}`,
  titulo: item.data.titulo,
  eyebrow: item.data.eyebrow,
  // Resumo INTEIRO. O corte é visual, por line-clamp no CSS: cortar na
  // string produzia reticências no meio da frase ("hidratação dos
  // lábios em…") e ainda tirava o texto completo do HTML, que é o que
  // busca e leitor de tela leem.
  resumo: item.data.resumo,
  imagem: item.data.imagemCapa,
  destaque: item.data.carroChefe,
}));
---

<section
  class="secao galeria"
  id="procedimentos"
  aria-labelledby="galeria-titulo"
>
  <div class="secao__inner">
    <div class="lead" data-bl-reveal>
      <p class="secao__idx brilho">04 — Procedimentos</p>
      <h2 id="galeria-titulo" class="galeria__titulo display on-video">
        Um catálogo por indicação, não por tendência
      </h2>
      <p class="galeria__corpo on-video">
        Preenchimento labial, bioestimuladores de colágeno, toxina botulínica e
        harmonização, peelings e protocolos de pele — cada um com indicações e
        contraindicações claras, para você decidir com informação, não com
        pressa.
      </p>
    </div>

    <div class="galeria__grade" data-bl-reveal>
      <ChromaGrid client:visible itens={itens} raio={340} />
    </div>

    <div class="galeria__mais lead" data-bl-reveal>
      <Button href="/procedimentos" variante="texto">
        Ver o catálogo completo →
      </Button>
    </div>
  </div>
</section>

<style>
  .galeria__titulo {
    font-variation-settings: "opsz" 44, "wght" 600, "wdth" 96;
    font-size: clamp(1.9rem, 4.4vw, var(--font-size-3xl));
    line-height: 1.02;
    letter-spacing: var(--type-display-tracking);
    color: var(--text-heading);
    margin: var(--space-stack-xs) 0 var(--space-stack-sm);
    max-width: 18ch;
    text-wrap: balance;
  }

  .galeria__corpo {
    font-size: var(--font-size-md);
    line-height: var(--type-body-leading);
    color: var(--text-muted);
    max-width: 56ch;
    margin: 0 0 var(--space-stack-lg);
  }

  .galeria__mais {
    margin-top: var(--space-stack-lg);
  }

  /* --------------------------------------------------------------
     ChromaGrid. O CSS vive aqui (não no JSX) pelo bug do minificador
     documentado no componente; :global porque a marcação nasce dentro
     da ilha React, sem o data-astro-cid-* do escopo.
     -------------------------------------------------------------- */

  .galeria__grade :global(.chroma) {
    --holofote-raio: 340px;
    --holofote-x: 50%;
    --holofote-y: 50%;
    --holofote-forca: 0;

    position: relative;
    display: grid;
    /* Ritmo irregular de propósito: o carro-chefe ocupa DUAS COLUNAS
       (nunca duas linhas). Cinco caixas idênticas seriam o anti-padrão
       que a direção visual proíbe em texto.
       O span vertical foi testado e descartado: com as linhas
       dimensionadas pelo conteúdo, a peça esticada realimentava a
       altura da linha e a grade disparava (visto em captura).
       17rem não é número mágico: com 5 procedimentos, o destaque
       ocupando 2 trilhas dá 6 células, e essa medida mantém a contagem
       de colunas em 2, 3 ou 4 em toda a faixa útil — 6 divide por
       todas, então nunca sobra um órfão sozinho na última linha. */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-gutter);
  }

  .galeria__grade :global(.chroma__peca) {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-xs);
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: var(--border-width-hairline) solid var(--surface-glass-border);
    background-color: var(--surface-glass-strong);
    background-image: var(--surface-glass-tint);
    padding-bottom: var(--space-stack-md);
    /* Container próprio: a inicial de descanso é dimensionada em cqw,
       ou seja, na largura DA PEÇA — assim a peça larga do carro-chefe
       ganha uma letra proporcionalmente maior sem regra extra. */
    container-type: inline-size;
    /* Descanso dessaturado: é o holofote que devolve a cor. */
    filter: saturate(0.5) brightness(0.86);
    transition:
      filter var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }

  .galeria__grade :global(.chroma__peca[data-destaque="true"]) {
    grid-column: span 2;
    border-color: var(--color-gold-500);
  }

  .galeria__grade :global(.chroma__peca:hover),
  .galeria__grade :global(.chroma__peca:focus-visible) {
    filter: none;
    border-color: var(--color-gold-500);
    box-shadow: var(--bloom);
  }

  .galeria__grade :global(.chroma__peca:focus-visible) {
    outline: none;
    box-shadow: var(--ring-focus);
  }

  /* Proporção fixa: sem isso a grade pula de altura quando as fotos
     reais entrarem no lugar dos placeholders. */
  .galeria__grade :global(.chroma__moldura) {
    display: block;
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: linear-gradient(
      160deg,
      var(--color-obsidian-700) 0%,
      var(--color-obsidian-900) 100%
    );
  }

  /* Peça larga pede imagem larga: a proporção vertical de capa ficaria
     desproporcional em duas colunas. */
  .galeria__grade :global(.chroma__peca[data-destaque="true"] .chroma__moldura) {
    aspect-ratio: 16 / 10;
  }

  .galeria__grade :global(.chroma__imagem) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Estado sem foto: inicial vazada em ouro, ancorada no canto como
     marca d'água editorial, com um fio metálico atravessando. A 1ª
     versão sobrepunha a chave `{` gigante à inicial e as duas letras
     brigavam — lia como erro de renderização, não como composição. */
  .galeria__grade :global(.chroma__vazio) {
    position: absolute;
    inset: 0;
    display: block;
  }

  /* Ancorada DENTRO da moldura: a moldura tem overflow hidden, então
     qualquer deslocamento negativo decepa a letra pela metade — foi o
     que aconteceu na 1ª tentativa. */
  .galeria__grade :global(.chroma__inicial) {
    position: absolute;
    left: var(--space-inline-sm);
    bottom: var(--space-inline-xs);
    font-family: var(--type-display-font);
    font-variation-settings: "opsz" 96, "wght" 250, "wdth" 82;
    font-size: clamp(3.5rem, 11cqw, 6rem);
    line-height: 0.86;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-gold-600);
  }

  .galeria__grade :global(.chroma__fio) {
    position: absolute;
    left: 12%;
    right: 12%;
    top: 38%;
    height: 1px;
    background: var(--gradient-metal);
    opacity: 0.5;
  }

  .galeria__grade :global(.chroma__peca[data-tom="1"] .chroma__moldura) {
    background: linear-gradient(
      160deg,
      var(--color-obsidian-600) 0%,
      var(--color-obsidian-950) 100%
    );
  }

  .galeria__grade :global(.chroma__peca[data-tom="2"] .chroma__moldura) {
    background: linear-gradient(
      200deg,
      var(--color-obsidian-800) 0%,
      var(--color-obsidian-600) 100%
    );
  }

  /* O selo explica a borda dourada: sem ele o destaque parecia só um
     cartão com a moldura diferente, sem motivo declarado. */
  .galeria__grade :global(.chroma__selo) {
    position: absolute;
    top: var(--space-inline-sm);
    left: var(--space-inline-sm);
    z-index: 1;
    font-family: var(--type-eyebrow-font);
    font-size: var(--badge-font-size);
    letter-spacing: var(--badge-tracking);
    text-transform: uppercase;
    border-radius: var(--badge-radius);
    padding: var(--space-inline-xs) var(--space-inline-sm);
    background: var(--surface-accent-soft);
    color: var(--text-accent-strong);
  }

  .galeria__grade :global(.chroma__texto) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-inline: var(--space-stack-sm);
    padding-top: var(--space-stack-sm);
  }

  .galeria__grade :global(.chroma__eyebrow) {
    font-family: var(--type-eyebrow-font);
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--type-eyebrow-tracking);
    color: var(--text-accent);
  }

  .galeria__grade :global(.chroma__titulo) {
    font-family: var(--type-display-font);
    font-variation-settings: "opsz" 24, "wght" 620;
    font-size: var(--font-size-lg);
    color: var(--text-heading);
    text-wrap: balance;
  }

  /* Corte por linhas, não por caracteres: o texto completo continua no
     HTML (busca e leitor de tela leem tudo) e nunca sai reticência no
     meio de uma palavra. */
  .galeria__grade :global(.chroma__resumo) {
    font-size: var(--font-size-sm);
    line-height: var(--type-body-leading);
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  .galeria__grade :global(.chroma__peca[data-destaque="true"] .chroma__resumo) {
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  /* A LUZ. Pinta por cima da grade inteira, em soft-light, e não recebe
     ponteiro. Só paint — nenhum layout, nenhuma composição por peça. */
  .galeria__grade :global(.chroma__luz) {
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: var(--radius-lg);
    opacity: var(--holofote-forca);
    mix-blend-mode: soft-light;
    transition: opacity var(--duration-slow) var(--ease-standard);
    background: radial-gradient(
      circle var(--holofote-raio) at var(--holofote-x) var(--holofote-y),
      var(--color-champagne) 0%,
      rgba(233, 211, 163, 0.35) 38%,
      transparent 72%
    );
  }

  /* Toque: sem ponteiro não há holofote, então a dessaturação de
     descanso não faria sentido nenhum — tudo nasce nítido e a
     interação é o toque direto na peça. */
  @media (pointer: coarse) {
    .galeria__grade :global(.chroma__peca) {
      filter: none;
    }

    .galeria__grade :global(.chroma__luz) {
      display: none;
    }

    .galeria__grade :global(.chroma__peca:active) {
      transform: scale(0.985);
    }
  }

  @container site (max-width: 620px) {
    /* CELULAR: faixa horizontal, não capa. Numa coluna só, a proporção
       4/5 dá uma peça de ~515px de altura; cinco delas viram um scroll
       interminável de capas quase vazias (medido em captura no Pixel
       7). A leitura correta aqui é lista: miniatura à esquerda, texto à
       direita, vários itens por tela. */
    .galeria__grade :global(.chroma) {
      grid-template-columns: 1fr;
    }

    .galeria__grade :global(.chroma__peca) {
      flex-direction: row;
      align-items: stretch;
      gap: 0;
      padding-bottom: 0;
    }

    .galeria__grade :global(.chroma__peca[data-destaque="true"]) {
      grid-column: span 1;
    }

    .galeria__grade :global(.chroma__moldura),
    .galeria__grade
      :global(.chroma__peca[data-destaque="true"] .chroma__moldura) {
      flex: 0 0 auto;
      width: 7.5rem;
      aspect-ratio: 1;
    }

    /* min-width: 0 — sem isto o item flex se recusa a encolher abaixo
       do conteúdo e o título longo estoura a peça pra fora da tela. */
    .galeria__grade :global(.chroma__texto) {
      flex: 1 1 auto;
      min-width: 0;
      justify-content: center;
      padding: var(--space-inline-sm) var(--space-stack-sm);
    }

    .galeria__grade :global(.chroma__resumo),
    .galeria__grade :global(.chroma__peca[data-destaque="true"] .chroma__resumo) {
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }

    .galeria__grade :global(.chroma__inicial) {
      font-size: 2.75rem;
    }

    /* Volta pro fluxo: sobre a faixa não há área de imagem livre onde
       pousar sem tapar texto. */
    .galeria__grade :global(.chroma__selo) {
      position: static;
      align-self: flex-start;
      margin-bottom: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .galeria__grade :global(.chroma__peca) {
      filter: none;
      transition: none;
    }

    .galeria__grade :global(.chroma__luz) {
      display: none;
    }
  }
</style>
