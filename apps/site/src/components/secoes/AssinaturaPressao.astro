---
// AssinaturaPressao — assinatura tipográfica que fecha a landing:
// "BEATRIZ LIMA" gigante em Bricolage variável, com as letras reagindo
// à pressão do cursor/dedo (TextPressure, ReactBits — ver
// reactbits/TextPressure.jsx). client:visible: o JS da ilha React só
// baixa quando a seção entra no viewport — custo zero no LCP do hero.
import TextPressure from "../reactbits/TextPressure.jsx";
---

<section class="assinatura" id="assinatura" aria-label="Assinatura Beatriz Lima">
  <p class="assinatura__idx" data-bl-reveal>05 — A marca, em uma respiração</p>
  <div class="assinatura__area">
    <TextPressure client:visible text="BEATRIZ LIMA" />
  </div>
</section>

<style>
  /* Transparente: a assinatura flutua direto sobre o fundo vivo. Um
     escurecimento radial (retangular na caixa, não oval sobre o rosto) dá
     contraste ao texto claro do TextPressure — política de proteção 25/07. */
  .assinatura {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-section-lg);
  }

  .assinatura > * {
    position: relative;
    z-index: 1;
  }

  .assinatura::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      74% 90% at 50% 50%,
      rgba(12, 10, 7, 0.5) 0%,
      rgba(12, 10, 7, 0.18) 54%,
      transparent 78%
    );
  }

  .assinatura__idx {
    text-align: center;
    font-family: var(--type-eyebrow-font);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--type-eyebrow-tracking);
    color: var(--text-accent-on-inverse);
    margin: 0 0 var(--space-stack-md);
  }

  .assinatura__area {
    max-width: var(--container-xl);
    margin-inline: auto;
    padding-inline: var(--space-container-pad);
    /* Mais presença: a assinatura é o momento interativo da página
       (direção visual § Movimento) — merece o respiro de um ato. */
    height: clamp(8rem, 26vw, 22rem);
  }

  /* Estilo ESTÁTICO do TextPressure vive aqui (não em style inline no
     JSX): o minificador de HTML manglava o atributo style com aspas
     aninhadas do font-family — CSS de verdade + token do DS resolve.
     :global porque o <p> nasce dentro da ilha React, sem o
     data-astro-cid-* do escopo. */
  .assinatura__area :global(.text-pressure-titulo) {
    font-family: var(--type-display-font);
    font-weight: 200;
    color: var(--text-on-inverse);
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
    user-select: none;
    margin: 0;
    width: 100%;
    display: flex;
    justify-content: space-between;
    transform-origin: center top;
  }

  .assinatura__area :global(.text-pressure-titulo span) {
    display: inline-block;
  }
</style>
