---
// AssinaturaPressao — assinatura tipográfica que fecha a landing:
// "BEATRIZ LIMA" gigante em Bricolage variável, com as letras reagindo
// à pressão do cursor/dedo (TextPressure, ReactBits — ver
// reactbits/TextPressure.jsx). client:visible: o JS da ilha React só
// baixa quando a seção entra no viewport — custo zero no LCP do hero.
import TextPressure from "../reactbits/TextPressure.jsx";
---

<section class="assinatura" aria-label="Assinatura Beatriz Lima">
  <div class="assinatura__area">
    <TextPressure client:visible text="BEATRIZ LIMA" />
  </div>
</section>

<style>
  /* Transparente: a assinatura flutua direto sobre o fundo vivo. */
  .assinatura {
    overflow: hidden;
    padding-block: var(--space-section);
  }

  .assinatura__area {
    max-width: var(--container-xl);
    margin-inline: auto;
    padding-inline: var(--space-container-pad);
    /* Mais presença: a assinatura é o momento interativo da página
       (direção visual § Movimento) — merece o respiro de um ato. */
    height: clamp(8rem, 26vw, 22rem);
  }

  /* Estilo ESTÁTICO do TextPressure vive aqui (não em style inline no
     JSX): o minificador de HTML manglava o atributo style com aspas
     aninhadas do font-family — CSS de verdade + token do DS resolve.
     :global porque o <p> nasce dentro da ilha React, sem o
     data-astro-cid-* do escopo. */
  .assinatura__area :global(.text-pressure-titulo) {
    font-family: var(--type-display-font);
    font-weight: 200;
    color: var(--text-on-inverse);
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
    user-select: none;
    margin: 0;
    width: 100%;
    display: flex;
    justify-content: space-between;
    transform-origin: center top;
  }

  .assinatura__area :global(.text-pressure-titulo span) {
    display: inline-block;
  }
</style>
