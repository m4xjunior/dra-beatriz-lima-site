---
// AssinaturaPressao — dobra 05, a assinatura tipográfica que fecha a
// landing: "BEATRIZ LIMA" gigante em Bricolage variável, com as letras
// reagindo à pressão do cursor/dedo (TextPressure, ReactBits — ver
// reactbits/TextPressure.jsx).
//
// É o ÚNICO momento interativo da página (direção visual § Movimento),
// e por isso merece o respiro de um ato inteiro.
//
// client:visible: o JS da ilha React só baixa quando a seção entra no
// viewport — custo zero no LCP do hero. Até 25/07 existia uma segunda
// implementação, em vanilla, inline na index.astro; as duas divergiram
// (só a vanilla tinha o gate de visibilidade). Sobrou esta, com o gate
// portado pra dentro do componente.
import TextPressure from "../reactbits/TextPressure.jsx";
---

<section class="assinatura" id="assinatura" aria-label="Assinatura Beatriz Lima">
  <p class="assinatura__idx" data-bl-reveal>05 — A marca, em uma respiração</p>
  <div class="assinatura__area">
    <TextPressure client:visible text="BEATRIZ LIMA" />
  </div>
</section>

<style>
  /* Sem véu próprio: a assinatura flutua direto sobre o fundo vivo. O
     escurecimento de pé do scrim direcional já entrega o AA — o halo
     radial que existia aqui foi retirado pela política de proteção de
     texto de 25/07 (nada de oval sobre o rosto dela). */
  .assinatura {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-section-lg);
  }

  .assinatura__idx {
    text-align: center;
    font-family: var(--type-eyebrow-font);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--type-eyebrow-tracking);
    color: var(--text-accent);
    margin: 0 0 var(--space-stack-md);
  }

  .assinatura__area {
    max-width: var(--container-xl);
    margin-inline: auto;
    padding-inline: var(--edge);
    height: clamp(6rem, 21vw, 18rem);
  }

  /* Estilo ESTÁTICO do TextPressure vive aqui (não em style inline no
     JSX): o minificador de HTML manglava o atributo style com aspas
     aninhadas do font-family — CSS de verdade + token do DS resolve.
     :global porque o <p> nasce dentro da ilha React, sem o
     data-astro-cid-* do escopo. */
  .assinatura__area :global(.text-pressure-titulo) {
    font-family: var(--type-display-font);
    font-weight: 200;
    color: var(--text-heading);
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
    user-select: none;
    margin: 0;
    width: 100%;
    display: flex;
    justify-content: space-between;
    transform-origin: center top;
    /* Bloom champagne difuso + sombra curta: o texto claro sobrevive a
       QUALQUER frame do vídeo por baixo, inclusive os mais claros. */
    text-shadow:
      0 2px 60px rgba(247, 237, 214, 0.35),
      0 1px 3px rgba(8, 6, 4, 0.5);
  }

  .assinatura__area :global(.text-pressure-titulo span) {
    display: inline-block;
    font-variation-settings: "wght" 200, "wdth" 100;
  }

  @container site (max-width: 920px) {
    .assinatura__area {
      height: clamp(4.5rem, 27vw, 9rem);
    }
  }
</style>
