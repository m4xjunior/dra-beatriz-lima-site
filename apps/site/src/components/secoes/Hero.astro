---
// Hero — dobra 01, "A presença".
//
// Tipografia direto sobre o vídeo, SEM caixa de vidro: é um momento
// tipográfico (política de vidro §2 da direção visual), apoiado no
// scrim direcional do FundoVivo. Vidro aqui competiria com o rosto.
//
// ADR (24/07/2026, preservada): o retrato estático recortado, o canvas
// de scrub de frames e o fundo FloatingLines saíram desta arquitetura —
// o vídeo de fundo assumiu os três papéis (presença dela, movimento e
// atmosfera).
//
// A entrada é coreografada em CSS puro, não via BL·Motion: isto está
// ACIMA da dobra, e esperar o GSAP da CDN significaria um flash de
// conteúdo invisível bem no meio do LCP.
//
// Copy fixa (ver readme.md § CONTENT FUNDAMENTALS).
import Button from "../Button.astro";
---

<section class="hero" id="topo">
  <div class="hero__frame" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

  <div class="hero__wrap">
    <p class="hero__eyebrow on-video">
      <span class="rule" aria-hidden="true"></span>Goiânia — Biomedicina estética
    </p>

    <div class="hero__foot">
      <h1 class="hero__titulo display on-video">
        <span class="line"><span>Estética que</span></span>
        <span class="line"><span>valoriza <em class="hero__voce">você</em></span></span>
      </h1>
      <p class="hero__corpo on-video">
        Critério clínico acima de tendência. Cada procedimento parte de uma
        avaliação individual sobre o seu rosto — nunca de um padrão pronto.
      </p>
      <div class="hero__acoes">
        <Button href="/procedimentos" variante="primaria" magnetico>
          Ver procedimentos
        </Button>
        <Button
          href="https://www.instagram.com/biomedica.beatrizz"
          variante="secundaria"
          externo
          magnetico
        >
          Agendar avaliação
        </Button>
      </div>
    </div>

    <span class="hero__index on-video" aria-hidden="true">01 — A presença</span>

    <a class="hero__scroll" href="#posicionamento" aria-label="Rolar para ver mais">
      <span aria-hidden="true"></span>
    </a>
  </div>
</section>

<style>
  @keyframes heroRise {
    from {
      transform: translateY(112%);
    }
    to {
      transform: translateY(0);
    }
  }
  @keyframes heroUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes heroIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes heroDraw {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes heroScroll {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    50% {
      transform: translateY(7px);
      opacity: 1;
    }
  }

  /* svh (não vh): no mobile a barra do navegador recolhe e o vh trava no
     tamanho ALTO, empurrando o pé do hero pra fora da tela. */
  .hero {
    position: relative;
    min-height: calc(100svh - var(--nav-height, 4rem));
  }

  /* Cantos que se desenham: moldura de revista, sem fechar a imagem. */
  .hero__frame {
    position: absolute;
    inset: var(--edge);
    z-index: 3;
    pointer-events: none;
  }

  .hero__frame i {
    position: absolute;
    width: 44px;
    height: 44px;
    opacity: 0;
    animation: heroDraw var(--duration-slow) var(--ease-entrance) 0.15s both;
  }

  .hero__frame i:nth-child(1) {
    top: 0;
    left: 0;
    border-top: 1px solid var(--border-hairline);
    border-left: 1px solid var(--border-hairline);
  }
  .hero__frame i:nth-child(2) {
    top: 0;
    right: 0;
    border-top: 1px solid var(--border-hairline);
    border-right: 1px solid var(--border-hairline);
  }
  .hero__frame i:nth-child(3) {
    bottom: 0;
    left: 0;
    border-bottom: 1px solid var(--border-hairline);
    border-left: 1px solid var(--border-hairline);
  }
  .hero__frame i:nth-child(4) {
    bottom: 0;
    right: 0;
    border-bottom: 1px solid var(--border-hairline);
    border-right: 1px solid var(--border-hairline);
  }

  .hero__wrap {
    position: absolute;
    inset: 0;
    padding: calc(var(--edge) + 30px) var(--edge) calc(var(--edge) + 20px);
    width: min(100% - 2 * var(--edge), var(--container-xl));
    margin-inline: auto;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .hero__eyebrow {
    align-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-inline-sm);
    font-family: var(--type-eyebrow-font);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--type-eyebrow-tracking);
    color: var(--text-accent);
    margin: 0;
    animation: heroUp var(--duration-slow) var(--ease-entrance) 0.1s both;
  }

  .hero__eyebrow .rule {
    width: 34px;
    height: 1px;
    background: var(--border-hairline);
  }

  .hero__foot {
    align-self: end;
    width: min(100%, var(--lead));
  }

  .hero__titulo {
    font-variation-settings: "opsz" 92, "wght" 640, "wdth" 94;
    font-size: clamp(3rem, 6.4vw + 1rem, 6.6rem);
    line-height: 0.96;
    letter-spacing: var(--letter-spacing-tighter);
    color: var(--text-heading);
    margin: 0 0 var(--space-stack-md);
  }

  /* A máscara é o overflow da .line; o filho sobe de dentro dela. O
     padding vertical existe pra não decepar acentos e descidas. */
  .hero__titulo .line {
    display: block;
    overflow: hidden;
    padding-top: 0.16em;
    padding-bottom: 0.16em;
  }

  .hero__titulo .line > span {
    display: block;
    animation: heroRise var(--duration-slower) var(--ease-entrance) both;
  }

  .hero__titulo .line:nth-child(1) > span {
    animation-delay: 0.24s;
  }
  .hero__titulo .line:nth-child(2) > span {
    animation-delay: 0.38s;
  }

  /* "você" em Cormorant itálico — a voz humana dentro do grotesco. Uma
     palavra por headline basta. */
  .hero__voce {
    font-family: var(--type-quote-font);
    font-style: italic;
    font-weight: 500;
    font-variation-settings: normal;
    letter-spacing: 0;
    background: var(--gradient-gold-text);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: none;
  }

  .hero__corpo {
    font-size: var(--font-size-md);
    line-height: var(--type-body-leading);
    color: var(--text-body);
    max-width: 40ch;
    margin: 0 0 var(--space-stack-lg);
    animation: heroUp var(--duration-slow) var(--ease-entrance) 0.62s both;
  }

  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-inline-md);
    animation: heroUp var(--duration-slow) var(--ease-entrance) 0.74s both;
  }

  .hero__index {
    position: absolute;
    left: calc(var(--edge) + 2px);
    top: 50%;
    transform: translateY(-50%) rotate(180deg);
    writing-mode: vertical-rl;
    font-family: var(--type-eyebrow-font);
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--type-eyebrow-tracking);
    color: var(--text-subtle);
    animation: heroIn var(--duration-slower) ease 0.8s both;
  }

  .hero__scroll {
    position: absolute;
    bottom: var(--edge);
    right: var(--edge);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
    animation: heroIn var(--duration-slower) ease 0.9s both;
  }

  .hero__scroll span {
    width: 1px;
    height: 30px;
    background: linear-gradient(var(--color-gold-400), transparent);
    animation: heroScroll 2.2s var(--ease-standard) infinite;
  }

  .hero__scroll:focus-visible {
    outline: none;
    box-shadow: var(--ring-focus);
  }

  @container site (max-width: 920px) {
    .hero__wrap {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: calc(var(--edge) + 22px) var(--edge) calc(var(--edge) + 6px);
    }

    /* Chão de leitura do hero no mobile: no desktop o texto vive na
       coluna escura à esquerda; no mobile ele ancora no pé sobre o
       rosto. Faixa retangular ancorada ao pé, dissolvendo PRA CIMA
       (longe do rosto) — política de proteção de texto 25/07, nunca
       oval/box sobre o rosto. ::before = 1º na ordem de árvore, pinta
       sob o texto do .hero__wrap. */
    .hero::before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 64%;
      background: linear-gradient(
        180deg,
        transparent 0%,
        rgba(10, 8, 5, 0.3) 44%,
        rgba(10, 8, 5, 0.78) 100%
      );
      pointer-events: none;
    }

    .hero__foot {
      position: relative;
      width: 100%;
    }
    .hero__eyebrow {
      letter-spacing: var(--letter-spacing-wider);
    }
    .hero__titulo {
      font-size: clamp(2.3rem, 11vw, 3.6rem);
    }
    .hero__index,
    .hero__scroll {
      display: none;
    }
    .hero__acoes :global(.botao) {
      flex: 1 1 auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__frame i,
    .hero__eyebrow,
    .hero__titulo .line > span,
    .hero__corpo,
    .hero__acoes,
    .hero__index,
    .hero__scroll,
    .hero__scroll span {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
