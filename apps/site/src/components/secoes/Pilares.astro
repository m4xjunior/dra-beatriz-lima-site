---
// Pilares — os cinco princípios da prática da Dra. Beatriz.
// Redesign (Claude Design, 25/07): numerais grandes com traço (stroke)
// dourado + réguas hairline entre os itens, hover translateX.
//
// PROTEÇÃO DE TEXTO (política 25/07): o handoff veta o oval. Aqui a lista
// inteira vive num véu RETANGULAR (radius-lg, surface-glass*) — as réguas e
// numerais editoriais ficam por cima do vidro, com AA 4.5:1 garantido sobre
// o vídeo. (só a cabeça velada deixaria as linhas de item sem contraste.)
const pilares = [
  { nome: "Ciência", descricao: "Cada indicação parte de critério clínico, não de tendência." },
  { nome: "Ética", descricao: "Transparência sobre o que um procedimento pode e não pode entregar." },
  { nome: "Escuta", descricao: "Cada rosto é único, e o cuidado começa por ouvir o que você busca." },
  { nome: "Respeito", descricao: "Ao seu tempo, ao seu histórico e aos seus limites." },
  { nome: "Individualidade", descricao: "Nenhum protocolo é padrão — cada avaliação é sobre você." },
];
---

<section class="secao pil" id="pilares">
  <div class="secao__inner">
    <div class="pil__veu" data-bl-reveal>
      <div class="pil__head">
        <p class="secao__idx">03 — Pilares</p>
        <h2 class="pil__titulo display">O que sustenta cada avaliação</h2>
      </div>
      <ul class="pil__lista">
        {
          pilares.map((pilar, i) => (
            <li class="pil__item">
              <span class="pil__num" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <h3 class="pil__nome">{pilar.nome}</h3>
                <p class="pil__desc">{pilar.descricao}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .secao {
    position: relative;
    padding-block: var(--space-section-lg);
  }
  .secao__inner {
    max-width: var(--container-lg);
    margin-inline: auto;
    padding-inline: var(--space-container-pad);
  }
  .secao__idx {
    display: inline-flex;
    align-items: center;
    gap: var(--space-inline-sm);
    font-family: var(--type-eyebrow-font);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--type-eyebrow-tracking);
    color: var(--text-accent);
    margin: 0 0 var(--space-stack-xs);
  }
  .secao__idx::before {
    content: "";
    width: 34px;
    height: 1px;
    background: var(--border-hairline);
  }

  /* véu retangular do DS envolvendo cabeça + lista (AA garantido) */
  .pil__veu {
    padding: var(--space-stack-lg);
    background: var(--surface-glass-strong);
    -webkit-backdrop-filter: blur(18px) saturate(var(--glass-saturate, 1.4));
    backdrop-filter: blur(18px) saturate(var(--glass-saturate, 1.4));
    border: 1px solid var(--surface-glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--bloom);
  }

  .pil__head {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-stack-lg);
  }
  .pil__titulo {
    font-family: var(--type-display-font);
    font-variation-settings: "opsz" 44, "wght" 620, "wdth" 96;
    font-size: clamp(2rem, 5vw, var(--font-size-4xl));
    line-height: 1;
    letter-spacing: var(--type-display-tracking);
    color: var(--text-heading);
    margin: var(--space-stack-xs) 0 0;
    max-width: 18ch;
    text-wrap: balance;
  }

  .pil__lista {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin: 0;
    padding: 0;
  }
  .pil__item {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: var(--space-inline-lg);
    padding: var(--space-stack-md) var(--space-inline-sm);
    border-top: var(--border-width-hairline) solid var(--border-hairline);
    transition:
      background-color var(--duration-base) var(--ease-standard),
      transform var(--duration-base) var(--ease-entrance);
  }
  .pil__item:last-child {
    border-bottom: var(--border-width-hairline) solid var(--border-hairline);
  }
  .pil__item:hover {
    background: var(--surface-hover);
    transform: translateX(6px);
  }

  /* numeral grande, só contorno dourado (stroke) — assinatura editorial */
  .pil__num {
    font-family: var(--type-display-font);
    font-variation-settings: "opsz" 40, "wght" 280, "wdth" 88;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-gold-600);
  }
  .pil__nome {
    font-family: var(--type-display-font);
    font-variation-settings: "opsz" 22, "wght" 620;
    font-size: var(--font-size-xl);
    color: var(--text-heading);
    margin: 0 0 4px;
  }
  .pil__desc {
    font-size: var(--font-size-sm);
    line-height: var(--type-body-leading);
    color: var(--text-muted);
    margin: 0;
    max-width: 56ch;
  }

  /* Coluna única deliberada: sobre o vídeo vivo dela, a lista corrida com
     réguas douradas lê melhor que 2 colunas (o design original era 2-col
     por não ter retrato de fundo; aqui o retrato é o herói). */

  @media (max-width: 899px) {
    .secao {
      padding-block: var(--space-section);
    }
    .pil__veu {
      padding: var(--space-stack-md);
    }
    .pil__item:hover {
      transform: none;
    }
  }
</style>
