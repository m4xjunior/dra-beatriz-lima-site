---
// Pilares — dobra 03, os cinco princípios da prática.
//
// Lista com fios hairline, NÃO grade de cards: o que sustenta a
// avaliação é uma sequência de leitura. "Grade de cards idênticos" é
// anti-padrão explícito da direção visual, e cinco caixas iguais aqui
// seriam exatamente isso.
//
// Numerais vazados (stroke dourado) dão presença sem peso de tinta — o
// número nunca compete com o nome do pilar.
const pilares = [
  {
    nome: "Ciência",
    descricao: "Cada indicação parte de critério clínico, não de tendência.",
  },
  {
    nome: "Ética",
    descricao:
      "Transparência sobre o que um procedimento pode e não pode entregar.",
  },
  {
    nome: "Escuta",
    descricao:
      "Cada rosto é único, e o cuidado começa por ouvir o que você busca.",
  },
  {
    nome: "Respeito",
    descricao: "Ao seu tempo, ao seu histórico e aos seus limites.",
  },
  {
    nome: "Individualidade",
    descricao: "Nenhum protocolo é padrão — cada avaliação é sobre você.",
  },
];
---

<section class="secao pil" id="pilares">
  <div class="secao__inner">
    <div class="lead" data-bl-reveal>
      <p class="secao__idx brilho">03 — Pilares</p>
      <h2 class="pil__titulo display on-video">O que sustenta cada avaliação</h2>
    </div>

    <ul class="pil__lista">
      {
        pilares.map((pilar, i) => (
          <li class="pil__item on-video" data-bl-reveal>
            <span class="pil__num" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div>
              <h3 class="pil__nome">{pilar.nome}</h3>
              <p class="pil__desc">{pilar.descricao}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .pil__titulo {
    font-variation-settings: "opsz" 44, "wght" 600, "wdth" 96;
    font-size: clamp(2rem, 4.6vw, var(--font-size-4xl));
    line-height: 1;
    letter-spacing: var(--type-display-tracking);
    color: var(--text-heading);
    margin: var(--space-stack-xs) 0 var(--space-stack-lg);
    max-width: 16ch;
    text-wrap: balance;
  }

  .pil__lista {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin: 0;
    padding: 0;
    max-width: 46rem;
  }

  .pil__item {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: var(--space-inline-lg);
    padding: var(--space-stack-md) var(--space-inline-sm);
    border-top: var(--border-width-hairline) solid var(--border-hairline);
    transition: padding-left var(--duration-base) var(--ease-entrance);
  }

  .pil__item:last-child {
    border-bottom: var(--border-width-hairline) solid var(--border-hairline);
  }

  .pil__item:hover {
    padding-left: var(--space-stack-sm);
  }

  .pil__num {
    font-family: var(--type-display-font);
    font-variation-settings: "opsz" 40, "wght" 300, "wdth" 88;
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-gold-400);
  }

  .pil__nome {
    font-family: var(--type-display-font);
    font-variation-settings: "opsz" 22, "wght" 620;
    font-size: var(--font-size-xl);
    color: var(--text-heading);
    margin: 0 0 4px;
  }

  .pil__desc {
    font-size: var(--font-size-sm);
    line-height: var(--type-body-leading);
    color: var(--text-muted);
    margin: 0;
    max-width: 52ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .pil__item,
    .pil__item:hover {
      transition: none;
      padding-left: var(--space-inline-sm);
    }
  }
</style>
