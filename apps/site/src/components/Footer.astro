---
// Footer — fecho do site, herdando tema do [data-theme] do <html>.
//
// Sem ilha de vidro: o rodapé é o único bloco que pode ficar sobre a
// parte já escurecida do scrim (faixa de pé), então uma caixa aqui
// seria vidro decorativo — o que a política anti-excesso proíbe. Um fio
// hairline no topo basta pra separar do corpo da página.
//
// Slot nomeado "extra" opcional (link legal — Etapa 3).
const pilares = ["Ciência", "Ética", "Escuta", "Respeito", "Individualidade"];
const ano = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner" data-bl-reveal>
    <div class="footer__lockup">
      <p class="footer__mono">BL</p>
      <p class="footer__nome">
        Dra. Beatriz Lima<span>Biomédica Esteta · Goiânia</span>
      </p>
    </div>

    <ul class="footer__pilares" aria-label="Pilares da prática">
      {
        pilares.map((pilar) => (
          <li>
            <span class="footer__chave" aria-hidden="true">
              {"{"}
            </span>
            {pilar}
          </li>
        ))
      }
    </ul>

    <div class="footer__contato">
      <a
        href="https://www.instagram.com/biomedica.beatrizz"
        target="_blank"
        rel="noopener noreferrer"
        class="footer__instagram"
      >
        @biomedica.beatrizz
      </a>
      <span class="footer__local">Goiânia · GO</span>
    </div>

    <slot name="extra" />

    <p class="footer__legal">
      Conteúdo informativo — não substitui avaliação clínica presencial. Todo
      procedimento é individual; resultados dependem de indicação e histórico de
      cada paciente, conforme a Resolução CFBM nº 330/2020.
    </p>

    <p class="footer__copy">
      © {ano} Dra. Beatriz Lima. Todos os direitos reservados.
    </p>
  </div>
</footer>

<style>
  .footer {
    color: var(--text-body);
    padding: var(--space-section) var(--edge) var(--space-section-lg);
  }

  .footer__inner {
    position: relative;
    width: min(100% - 2 * var(--edge), var(--container-xl));
    margin-inline: auto;
    display: grid;
    gap: var(--space-stack-md);
    padding-top: var(--space-stack-lg);
    border-top: var(--border-width-hairline) solid var(--border-hairline);
  }

  /* Monograma em escala de assinatura: presença total no fecho, e o
     único lugar da página onde o metal ocupa área grande — porque aqui
     ele não compete com o rosto dela. */
  .footer__mono {
    font-family: var(--type-display-font);
    font-variation-settings: "opsz" 96, "wght" 300;
    font-size: clamp(4rem, 15vw, 8.5rem);
    line-height: 0.82;
    background: var(--gradient-metal);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin: 0;
  }

  .footer__nome {
    font-family: var(--type-display-font);
    text-transform: uppercase;
    letter-spacing: var(--type-eyebrow-tracking);
    font-size: var(--font-size-sm);
    color: var(--text-heading);
    margin: 0;
  }

  .footer__nome span {
    display: block;
    color: var(--text-accent);
    font-size: var(--font-size-2xs);
    margin-top: 4px;
  }

  .footer__pilares {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-inline-lg);
    padding: 0;
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--text-body);
  }

  .footer__chave {
    color: var(--text-accent);
    margin-right: 6px;
    font-family: var(--type-display-font);
  }

  .footer__contato {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-inline-lg);
    align-items: baseline;
    font-size: var(--font-size-sm);
  }

  .footer__instagram {
    color: var(--text-accent);
    text-decoration: none;
  }

  .footer__instagram:hover,
  .footer__instagram:focus-visible {
    text-decoration: underline;
  }

  .footer__local {
    color: var(--text-muted);
  }

  .footer__legal {
    font-size: var(--font-size-xs);
    line-height: var(--type-body-leading);
    max-width: 66ch;
    color: var(--text-muted);
    margin: 0;
  }

  .footer__copy {
    font-size: var(--font-size-2xs);
    color: var(--text-subtle);
    margin: 0;
  }

  @container site (min-width: 768px) {
    .footer__inner {
      grid-template-columns: auto 1fr auto;
      align-items: start;
    }
    .footer__legal,
    .footer__copy {
      grid-column: 1 / -1;
    }
  }
</style>
